# ── Database ──────────────────────────────────
# PostgreSQL connection string for local Docker DB
DATABASE_URL="postgresql://medboutique:medboutique_dev_2024@db:5432/medboutique_dev"

# ── Authentication (NextAuth.js) ──────────────
