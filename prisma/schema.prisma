// file: prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  RECEPTIONIST
  DOCTOR
}

enum AppointmentStatus {
  PENDING_PAYMENT
  PENDING_REQUIRED_FORMS
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role           @default(PATIENT)
  phone         String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  staffProfile   StaffProfile?
  auditLogs      AuditLog[]
  messages       Message[]
  statusLogs     PatientStatusLog[]
  sentForms      SafetyFormInstance[] @relation("SentForms")
}

model PatientProfile {
  id             String          @id @default(cuid())
  userId         String          @unique @map("user_id")
  dob            DateTime?
  gender         String?
  bloodGroup     String?
  medicalHistory String?         @db.Text
  address        String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  patientRecords PatientRecord[]
  invoices       Invoice[]
  diagnostics    DiagnosticSubmission[]
  carePlans      CarePlan[]
  conversations  Conversation[]
  formInstances  SafetyFormInstance[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id                      String             @id @default(cuid())
  userId                  String             @unique @map("user_id")
  specialty               String
  qualifications          String             // e.g. "MD, DNB (Dermatology)"
  consultationFee         Decimal            @db.Decimal(10, 2)
  googleCalendarSyncToken String?

  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots                   AvailabilitySlot[]
  appointments            Appointment[]
  conversations           Conversation[]

  @@map("doctor_profiles")
}

model StaffProfile {
  id             String          @id @default(cuid())
  userId         String          @unique @map("user_id")
  permissions    String[]        // Array of granular capability tags

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model AvailabilitySlot {
  id             String          @id @default(cuid())
  doctorId       String          @map("doctor_id")
  startTime      DateTime        @map("start_time")
  endTime        DateTime        @map("end_time")
  isBooked       Boolean         @default(false) @map("is_booked")

  doctor         DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment    Appointment?

  @@index([startTime, isBooked])
  @@map("availability_slots")
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String            @map("patient_id")
  doctorId           String            @map("doctor_id")
  slotId             String            @unique @map("slot_id")
  status             AppointmentStatus @default(PENDING_PAYMENT)
  reason             String?           @db.Text
  notes              String?           @db.Text
  paymentId          String?           @unique @map("payment_id") // Relates to Payment table
  treatmentId        String?           @map("treatment_id")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient            PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slot               AvailabilitySlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  payment            Payment?          @relation(fields: [paymentId], references: [id])
  treatment          Treatment?        @relation(fields: [treatmentId], references: [id])
  statusLogs         PatientStatusLog[]
  formInstances      SafetyFormInstance[]

  @@index([status])
  @@map("appointments")
}

model Payment {
  id                 String            @id @default(cuid())
  amount             Decimal           @db.Decimal(10, 2)
  currency           String            @default("INR")
  gatewayReference   String            @unique @map("gateway_reference") // Razorpay Payment ID
  status             String            // e.g. "SUCCESS", "FAILED"
  createdAt          DateTime          @default(now())

  appointment        Appointment?
  invoice            Invoice?

  @@map("payments")
}

model PatientRecord {
  id                 String            @id @default(cuid())
  patientId          String            @map("patient_id")
  clinicalNotes      String            @db.Text @map("clinical_notes")
  prescription       String?           @db.Text // Encrypted JSON payload containing medicines
  diagnosis          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient            PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attachments        Attachment[]

  @@map("patient_records")
}

model Attachment {
  id                 String            @id @default(cuid())
  recordId           String            @map("record_id")
  fileUrl            String            @map("file_url")
  fileType           String            @map("file_type")
  description        String?
  createdAt          DateTime          @default(now())

  record             PatientRecord     @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Invoice {
  id                 String            @id @default(cuid())
  patientId          String            @map("patient_id")
  paymentId          String?           @unique @map("payment_id")
  amountDue          Decimal           @db.Decimal(10, 2) @map("amount_due")
  amountPaid         Decimal           @db.Decimal(10, 2) @map("amount_paid")
  status             String            // "PAID", "PARTIAL", "UNPAID"
  invoicePdfUrl      String?           @map("invoice_pdf_url")
  createdAt          DateTime          @default(now())

  patient            PatientProfile    @relation(fields: [patientId], references: [id])
  payment            Payment?          @relation(fields: [paymentId], references: [id])

  @@map("invoices")
}

model DiagnosticSubmission {
  id                 String            @id @default(cuid())
  patientId          String?           @map("patient_id")
  leadName           String            @map("lead_name")
  leadEmail          String            @map("lead_email")
  leadPhone          String            @map("lead_phone")
  quizType           String            @map("quiz_type") // e.g. "SKIN_TYPE", "IVF_ESTIMATOR"
  answers            Json              // Structured user response
  recommendation     String            @db.Text
  createdAt          DateTime          @default(now())

  patient            PatientProfile?   @relation(fields: [patientId], references: [id])

  @@map("diagnostic_submissions")
}

model AuditLog {
  id                 String            @id @default(cuid())
  userId             String            @map("user_id")
  action             String            // e.g. "VIEW_RECORD", "DELETE_APPOINTMENT"
  entity             String            // e.g. "PatientRecord", "Appointment"
  entityId           String            @map("entity_id")
  ipAddress          String?           @map("ip_address")
  timestamp          DateTime          @default(now())

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model CarePlan {
  id           String         @id @default(cuid())
  patientId    String         @map("patient_id")
  assignedBy   String         @map("assigned_by") // e.g. "Dr. Aisha Rao"
  protocolName String         @map("protocol_name") // e.g. "Post-HydraFacial Protocol"
  tip          String?        @db.Text // Practitioner's daily clinical tip
  startDate    DateTime       @default(now()) @map("start_date")
  endDate      DateTime?      @map("end_date")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tasks        CarePlanTask[]

  @@map("care_plans")
}

enum TimeOfDay {
  MORNING
  EVENING
}

model CarePlanTask {
  id            String    @id @default(cuid())
  carePlanId    String    @map("care_plan_id")
  title         String
  instruction   String    @db.Text
  timeOfDay     TimeOfDay @map("time_of_day")
  scheduledTime String    @map("scheduled_time") // e.g. "08:00 AM"
  completed     Boolean   @default(false)

  carePlan      CarePlan  @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@map("care_plan_tasks")
}

model Conversation {
  id        String   @id @default(cuid())
  patientId String   @map("patient_id")
  doctorId  String   @map("doctor_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient  PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([patientId, doctorId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String   @db.Text
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ClinicSettings {
  id               String   @id @default("default")
  clinicName       String   @default("MedBoutique Clinic") @map("clinic_name")
  doctorName       String   @default("Dr. Aisha Sharma") @map("doctor_name")
  specialty        String   @default("Dermatology & Aesthetics")
  phone            String   @default("+91 98765 43210")
  address          String   @db.Text @default("Suite 402, Pacific Mall, Linking Road, Bandra West, Mumbai 400050")
  duration         Int      @default(60)
  buffer           Int      @default(15)
  bookingLimit     Int      @default(4) @map("booking_limit")
  openDays         String   @default("0,1,2,3,4,5") @map("open_days")
  whatsappConfirm  Boolean  @default(true) @map("whatsapp_confirm")
  whatsapp24h      Boolean  @default(true) @map("whatsapp_24h")
  sms1h            Boolean  @default(false) @map("sms_1h")
  emailInvoice     Boolean  @default(true) @map("email_invoice")
  newBookingAlert  Boolean  @default(true) @map("new_booking_alert")
  whatsappTemplate String   @db.Text @default("Hi {{patient_name}},\n\nYour appointment for {{treatment}} with {{doctor}} is confirmed for {{date}} at {{time}}.\n\nLocation: {{clinic_address}}\n\nSee you soon! — MedBoutique") @map("whatsapp_template")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("clinic_settings")
}

model ClinicStatus {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "Checked In", "Waiting Area", "Treatment Room"
  sortOrder Int      @map("sort_order") @default(0)
  createdAt DateTime @default(now())

  statusLogs PatientStatusLog[]
  @@map("clinic_statuses")
}

model PatientStatusLog {
  id             String       @id @default(cuid())
  appointmentId  String       @map("appointment_id")
  statusId       String       @map("status_id")
  updatedById    String       @map("updated_by_id")
  updatedAt      DateTime     @updatedAt @default(now())

  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status         ClinicStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  updatedBy      User         @relation(fields: [updatedById], references: [id])

  @@map("patient_status_logs")
}

model SafetyFormTemplate {
  id             String   @id @default(cuid())
  title          String   @unique // e.g., "Botox Treatment Consent", "Aesthetic Medical History"
  content        String   @db.Text
  category       String   @default("CONSENT") // "CONSENT", "HISTORY", "QUESTIONNAIRE", "FOLLOW_UP"
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  isArchived     Boolean  @default(false) @map("is_archived")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  instances      SafetyFormInstance[]
  @@map("safety_form_templates")
}

model SafetyFormInstance {
  id             String             @id @default(cuid())
  templateId     String             @map("template_id")
  patientId      String             @map("patient_id")
  appointmentId  String             @map("appointment_id")
  status         String             @default("SENT") // "SENT", "VIEWED", "COMPLETED", "EXPIRED"
  sentAt         DateTime           @default(now()) @map("sent_at")
  sentById       String?            @map("sent_by_id")
  viewedAt       DateTime?          @map("viewed_at")
  completedAt    DateTime?          @map("completed_at")
  expiresAt      DateTime?          @map("expires_at")
  isSigned       Boolean            @default(false) @map("is_signed")
  signatureUrl   String?            @map("signature_url")
  responseJson   Json?              @map("response_json")
  createdAt      DateTime           @default(now())

  patient        PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  template       SafetyFormTemplate @relation(fields: [templateId], references: [id])
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sentBy         User?              @relation("SentForms", fields: [sentById], references: [id])

  @@map("safety_form_instances")
}

model Treatment {
  id                  String        @id @default(cuid())
  name                String
  description         String?       @db.Text
  duration            Int           // in minutes
  price               Decimal       @db.Decimal(10, 2)
  depositAmount       Decimal?      @db.Decimal(10, 2) @map("deposit_amount")
  fullPaymentRequired Boolean       @default(false) @map("full_payment_required")
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  appointments        Appointment[]

  @@map("treatments")
}


