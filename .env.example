# ─────────────────────────────────────────────
# MedBoutique OS — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Database ──────────────────────────────────
# PostgreSQL connection string (Supabase or Neon recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medboutique?sslmode=require"

# ── Authentication (NextAuth.js) ──────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Razorpay (Payment Gateway) ────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ── WhatsApp Business API (WATI) ──────────────
WATI_API_TOKEN="your_wati_api_token"
WATI_API_ENDPOINT="https://live-server-XXXXX.wati.io"

# ── Google Calendar (OAuth 2.0) ───────────────
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ── Upstash Redis (Caching — Optional) ────────
UPSTASH_REDIS_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_TOKEN="your_upstash_token"

# ── App Config ────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLINIC_NAME="MedBoutique Clinic"
