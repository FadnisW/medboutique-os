# ─────────────────────────────────────────────
# MedBoutique OS — .gitignore
# ─────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js Build Outputs ────────────────────
/.next/
/out/
/build

# ── Environment Variables (NEVER commit these)─
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Database ─────────────────────────────────
*.db
*.sqlite

# ── Testing ───────────────────────────────────
/coverage
/playwright-report
/test-results

# ── Editors & OS ─────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/settings.json

# ── Misc ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# ── TestSprite ────────────────────────────────
/testsprite_tests/
*.tsbuildinfo
next-env.d.ts
